POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-or-gemini-api-key

# Signing key for JWTs (>= 32 random bytes, base64)
JWT_SECRET=replace-with-at-least-32-random-bytes-base64

# The first ADMIN account is created at startup from these two values
ADMIN_EMAIL=admin@lumora.com
ADMIN_PASSWORD=change-me-admin-password
